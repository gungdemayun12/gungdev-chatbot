# ==========================================================
# .dockerignore — memperkecil build context
# ==========================================================
# Dipakai bila build context = root repo.
# Frontend tidak diperlukan untuk image backend.
# ==========================================================
chatbot-saya/frontend/node_modules
chatbot-saya/frontend/dist
chatbot-saya/frontend/.env
chatbot-saya/frontend/.env.local

# Python
**/__pycache__
**/*.py[cod]
**/venv
**/.venv
**/.pytest_cache

# Rahasia & git
**/.env
**/.env.local
.git
.gitignore

# Editor / OS
**/.vscode
**/.idea
**/.DS_Store
**/Thumbs.db

# Artefak uji
**/*.png
**/*.mjs

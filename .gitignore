# --- Environment & rahasia ---
.env
.env.local
.env.*.local
!.env.example

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Vercel ---
.vercel/

# --- Artefak uji ---
e2e-desktop.png
e2e-mobile.png
shot-*.png

commit-msg.txt

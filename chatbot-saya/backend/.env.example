# ==========================================================
# Konfigurasi backend GungDev
# ==========================================================
# Salin file ini menjadi ".env" lalu isi nilainya.
# File ".env" TIDAK di-commit ke Git (sudah masuk .gitignore).
# ==========================================================

# ----------------------------------------------------------
# PILIH PROVIDER
# ----------------------------------------------------------
# "groq"   = API cloud (untuk deploy publik, cepat)
# "ollama" = model lokal (untuk pengembangan)
# Kosongkan untuk deteksi otomatis:
#   - ada GROQ_API_KEY -> groq
#   - tidak ada        -> ollama
AI_PROVIDER=

# ----------------------------------------------------------
# GROQ (https://console.groq.com/keys)
# ----------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------
# OLLAMA LOKAL
# ----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# ----------------------------------------------------------
# OPENROUTER (https://openrouter.ai/keys)
# ----------------------------------------------------------
# Dipakai bila AI_PROVIDER=openrouter. Isi juga AI_PROVIDER di atas.
OPENROUTER_API_KEY=
# Identitas aplikasi yang dikirim ke OpenRouter (untuk papan peringkat).
# Isi dengan domain situs Anda, bukan rahasia.
OPENROUTER_SITE_URL=https://gungdevchatbot.vercel.app
OPENROUTER_APP_NAME=GungDev

# ----------------------------------------------------------
# GOOGLE GEMINI â€” PENYEDIA CADANGAN (gratis, tanpa kartu kredit)
# ----------------------------------------------------------
# Ambil dari https://aistudio.google.com/apikey
#
# MENGAPA ADA: Groq membatasi 200.000 token/hari per model. Bila kuota
# itu habis, dahulu seluruh situs berhenti melayani. Dengan kunci ini,
# permintaan otomatis dialihkan ke Gemini saat penyedia lain kehabisan
# kuota (HTTP 429/402), sehingga pengguna tetap mendapat jawaban.
#
# Bila dikosongkan, perilaku situs kembali seperti semula (Groq dan
# OpenRouter saja). Tidak ada yang rusak.
GEMINI_API_KEY=
# Model default. Wajib generasi 3.5 ke atas: model 2.0 sudah dimatikan
# Google dan 2.5 sudah deprecated. Lihat daftar hidup dengan
# `python uji_model_gemini.py` (model yang sudah dipakai) atau
# `python uji_model_baru.py` (mencari model TAMBAHAN yang hidup).
GEMINI_MODEL=gemini-3.5-flash-lite

# ----------------------------------------------------------
# NVIDIA NIM â€” PENYEDIA KEEMPAT (gratis, tanpa kartu kredit)
# ----------------------------------------------------------
# CARA MENGAMBIL KEY (langkah lengkap):
#   1. Buka https://build.nvidia.com  -> Sign in / Create Account
#      (akun NVIDIA Developer, gratis, tanpa kartu kredit).
#   2. Buka https://build.nvidia.com/settings/api-keys
#   3. Klik "Generate API Key", beri nama bebas (mis. "gungdev").
#   4. SALIN SEKARANG â€” key hanya ditampilkan sekali.
#      Bentuknya: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   5. Periksa dulu sebelum dipasang:
#        $env:NVIDIA_API_KEY="nvapi-..."
#        python cek_key.py nvidia
#      Harus muncul "OK".
#
# PENTING â€” BACA SEBELUM MENGHARAPKAN JATAH NAIK:
# NVIDIA memberi "trial credits" (~1.000 panggilan), BUKAN kuota harian
# permanen. Kreditnya terbatas dan berlaku Â±90 hari. Karena itu NVIDIA:
#   - MENAMBAH PILIHAN MODEL (Nemotron, Kimi, GLM, MiniMax), dan
#   - menjadi jalur cadangan keempat saat Groq/Gemini/OpenRouter habis,
#   - tetapi TIDAK menaikkan jatah harian per akun (lihat usage.py).
# Bila dikosongkan, seluruh bagian NVIDIA dilewati tanpa merusak apa pun.
NVIDIA_API_KEY=
# Model default NVIDIA. JANGAN isi dengan model lama: NVIDIA mematikan
# model tanpa pemberitahuan panjang (dibalas HTTP 410 "end of life").
# Daftar model yang masih hidup: python cek_key.py nvidia
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ----------------------------------------------------------
# CLOUDFLARE WORKERS AI â€” PENYEDIA KELIMA (gratis, TANPA kartu kredit)
# ----------------------------------------------------------
# MENGAPA INI DIPILIH:
# Satu-satunya penyedia yang kuotanya RESET HARIAN (bukan bulanan) DAN
# tidak memerlukan kartu kredit.
#
#   Kuota : 10.000 Neuron/hari, reset 00:00 UTC
#   Kartu : tidak perlu
#   API   : kompatibel OpenAI
#
# 10.000 Neuron setara (perkiraan 1.500 token masuk + 600 token keluar):
#   granite-4.0-h-micro  ~1.189 pesan/hari   <- paling hemat
#   qwen3-30b-a3b          ~396 pesan/hari
#   gemma-4-26b-a4b        ~333 pesan/hari
#   gpt-oss-120b           ~229 pesan/hari   <- paling pintar, default
#   qwen2.5-coder-32b       ~69 pesan/hari   <- khusus coding
#
# CARA MENGAMBIL KUNCI (dua bagian, keduanya wajib):
#   1. Daftar di https://dash.cloudflare.com (gratis, tanpa kartu).
#   2. Buka menu "Workers AI" -> klik "Use REST API".
#      Di situ terlihat ACCOUNT ID. Salin.
#   3. Buat API token: "My Profile" -> "API Tokens" -> "Create Token"
#      -> pilih template "Workers AI" (atau buat sendiri dengan izin
#      "Workers AI - Read" DAN "Workers AI - Edit"), lalu salin tokennya.
#   4. Periksa dulu sebelum dipasang:
#        $env:CLOUDFLARE_ACCOUNT_ID="..."
#        $env:CLOUDFLARE_API_TOKEN="..."
#        python cek_key.py cloudflare
#      Harus muncul "OK".
#
# PENTING - JANGAN HARAP TERLALU BANYAK:
# Model coding TERBAIK Cloudflare (kimi-k2.7-code, glm-5.3, deepseek-v4)
# WAJIB metode pembayaran berbayar, jadi TIDAK dipakai di sini. Yang
# dipakai adalah model gratis: gpt-oss-120b (terpintar gratis),
# qwen2.5-coder (khusus coding), gemma-4-26b, llama-4-scout (baca gambar),
# granite-4.0-h-micro (paling hemat).
#
# Bila dikosongkan, seluruh bagian Cloudflare dilewati tanpa merusak apa
# pun (situs kembali memakai Groq/Gemini/OpenRouter/NVIDIA saja).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Model default. Biarkan kosong untuk memakai cloudflare/gpt-oss-120b.
CLOUDFLARE_MODEL=

# ----------------------------------------------------------
# MISTRAL â€” BELUM DIDUKUNG (catatan saja)
# ----------------------------------------------------------
# Dokumentasi resmi Mistral menyatakan "Free mode" TIDAK termasuk akses
# API; membuat API key butuh aktivasi billing. Karena itu Mistral tidak
# dipakai: tidak bisa benar-benar gratis seperti yang dijanjikan
# banyak daftar di internet.


# ----------------------------------------------------------
# UPSTASH REDIS â€” penyimpanan riwayat per akun (WAJIB untuk sinkron)
# ----------------------------------------------------------
# Ambil dari https://console.upstash.com -> Redis -> REST API.
# Bila DUA variabel ini kosong, riwayat TIDAK bisa disinkronkan antar
# perangkat dan UI menampilkan "Riwayat sementara hanya di perangkat
# ini". Chat tetap berjalan, tetapi riwayat hilang saat ganti perangkat.
# Cek status di produksi: GET /diagnostik -> "penyimpanan_riwayat".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------
# GOOGLE SIGN-IN (verifikasi ID token di server)
# ----------------------------------------------------------
# Client ID Google (bukan Client Secret). Nilai ini PUBLIK dan juga
# dipakai frontend sebagai VITE_GOOGLE_CLIENT_ID.
# Bila kosong, /api/sessions selalu menolak (401) sehingga riwayat per
# akun tidak bisa dipakai. Cek status di produksi:
# GET /diagnostik -> "verifikasi_login".
GOOGLE_CLIENT_ID=

# ----------------------------------------------------------
# CORS â€” domain frontend yang boleh memanggil backend
# ----------------------------------------------------------
# Subdomain *.vercel.app sudah otomatis diizinkan.
# Tambahkan domain sendiri di sini, pisahkan dengan koma.
# Contoh: ALLOWED_ORIGINS=https://gungdev.com,https://www.gungdev.com
ALLOWED_ORIGINS=

# ----------------------------------------------------------
# TIMEOUT (detik)
# ----------------------------------------------------------
TIMEOUT_GROQ=120
TIMEOUT_OLLAMA=300
# Gemini bisa lebih lambat saat "thinking"; beri ruang lebih lega.
TIMEOUT_GEMINI=90

# ----------------------------------------------------------
# GAMBAR: MESIN UTAMA (Gemini) DAN CADANGAN GRATIS
# ----------------------------------------------------------
# Kunci Gemini DIPAKAI BERSAMA dengan penyedia teks. Bedanya hanya nama
# model: model teks tidak bisa membuat gambar, sedangkan model gambar
# (gemini-3.1-flash-image) bisa.
#
# Bila kuota Gemini habis atau gagal, gambar otomatis dibuat lewat
# layanan gratis, jadi fitur gambar TIDAK pernah mati.
#
# Kosongkan GEMINI_GAMBAR_MODEL untuk mematikan mesin utama tanpa
# menghapus kuncinya.
GEMINI_GAMBAR_MODEL=gemini-3.1-flash-image
# 512 / 1K / 2K / 4K. 1K cukup tajam dan tidak membengkakkan riwayat.
GEMINI_GAMBAR_UKURAN=1K
# Batas waktu satu permintaan Gemini (detik). Harus menyisakan waktu untuk
# cadangan; total tetap di bawah maxDuration Vercel (60 detik).
GEMINI_GAMBAR_TIMEOUT=40
# Jatah waktu cadangan gratis setelah Gemini gagal (detik).
GAMBAR_CADANGAN_TIMEOUT=45

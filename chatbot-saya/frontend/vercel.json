{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/health"
    },
    {
      "source": "/usage",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/usage"
    },
    {
      "source": "/capabilities",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/capabilities"
    },
    {
      "source": "/diagnostik",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/diagnostik"
    },
    {
      "source": "/chat",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/chat"
    },
    {
      "source": "/chat/stream",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/chat/stream"
    },
    {
      "source": "/api/chat",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/chat"
    },
    {
      "source": "/api/chat/stream",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/chat/stream"
    },
    {
      "source": "/api/sessions",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/api/sessions"
    },
    {
      "source": "/api/sessions/(.*)",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/api/sessions/$1"
    },
    {
      "source": "/c/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!health|usage|capabilities|diagnostik|chat|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

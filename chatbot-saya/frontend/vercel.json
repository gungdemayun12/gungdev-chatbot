{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/health"
    },
    {
      "source": "/usage",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/usage"
    },
    {
      "source": "/capabilities",
      "destination": "https://gungdev-chatbot-rq5l.vercel.app/capabilities"
    },
    {
      "source": "/((?!health|usage|capabilities|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

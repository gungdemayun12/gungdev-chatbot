# ==========================================================
# URL backend GungDev
# ==========================================================
# Untuk pengembangan lokal (default, boleh dikosongkan):
VITE_API_URL=http://localhost:8000

# ==========================================================
# Untuk DEPLOY (Vercel / hosting lain):
# ==========================================================
# Ganti dengan URL backend publik Anda, HARUS https.
# Contoh: VITE_API_URL=https://gungdev-api.onrender.com
#
# Variabel ini dibaca saat BUILD, jadi setelah mengubahnya
# lakukan redeploy di Vercel (Settings → Environment Variables).
# ==========================================================

# ==========================================================
# URL backend GungDev
# ==========================================================
# Untuk pengembangan lokal (default, boleh dikosongkan):
VITE_API_URL=http://localhost:8000

# ==========================================================
# Untuk DEPLOY (Vercel / hosting lain):
# ==========================================================
# Ganti dengan URL backend publik Anda, HARUS https.
# Contoh: VITE_API_URL=https://gungdev-api.onrender.com
#
# Variabel ini dibaca saat BUILD, jadi setelah mengubahnya
# lakukan redeploy di Vercel (Settings → Environment Variables).
# ==========================================================

# ==========================================================
# LOGIN DENGAN GOOGLE
# ==========================================================
# Client ID OAuth dari Google Cloud Console
# (Credentials → OAuth client ID → Application type: Web application).
#
# Bentuknya panjang dan berakhiran .apps.googleusercontent.com
# Contoh:
#   VITE_GOOGLE_CLIENT_ID=123456789012-abc123def456.apps.googleusercontent.com
#
# PENTING:
#   - Ini Client ID, BUKAN Client Secret. Client ID memang publik dan
#     aman ditulis di kode frontend (memang begitu cara kerja Google).
#   - Client Secret TIDAK dipakai di frontend. Jangan pernah menaruhnya
#     di file ini.
#   - Di Vercel, tambahkan sebagai Environment Variable dengan tipe
#     "Plain Text" (bukan Sensitive), karena nilainya ikut di-build.
#   - Tambahkan juga domain situs pada "Authorized JavaScript origins"
#     di Google Cloud Console, mis. https://namasitus.vercel.app
#
# Bila dibiarkan kosong: situs tetap berjalan normal, tetapi tombol
# "Masuk dengan Google" hanya menampilkan pemberitahuan bahwa login
# belum diaktifkan.
# ==========================================================
VITE_GOOGLE_CLIENT_ID=
